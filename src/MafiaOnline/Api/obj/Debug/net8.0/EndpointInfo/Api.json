{
  "openapi": "3.0.1",
  "info": {
    "title": "Api",
    "version": "1.0"
  },
  "paths": {
    "/api/lobbies": {
      "post": {
        "tags": [
          "Lobbies"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateLobbyRequest"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateLobbyRequest"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/CreateLobbyRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/LobbyResponse"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LobbyResponse"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/LobbyResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/lobbies/join": {
      "post": {
        "tags": [
          "Lobbies"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/JoinLobbyRequest"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/JoinLobbyRequest"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/JoinLobbyRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/LobbyResponse"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LobbyResponse"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/LobbyResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/lobbies/{code}": {
      "get": {
        "tags": [
          "Lobbies"
        ],
        "parameters": [
          {
            "name": "code",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/LobbyResponse"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LobbyResponse"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/LobbyResponse"
                }
              }
            }
          }
        }
      }
    },
    "/WeatherForecast": {
      "get": {
        "tags": [
          "WeatherForecast"
        ],
        "operationId": "GetWeatherForecast",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/WeatherForecast"
                  }
                }
              },
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/WeatherForecast"
                  }
                }
              },
              "text/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/WeatherForecast"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CreateLobbyRequest": {
        "type": "object",
        "properties": {
          "nickname": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "JoinLobbyRequest": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "nullable": true
          },
          "nickname": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "LobbyResponse": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "nullable": true
          },
          "started": {
            "type": "boolean"
          },
          "players": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PlayerResponse"
            },
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "PlayerResponse": {
        "type": "object",
        "properties": {
          "nickname": {
            "type": "string",
            "nullable": true
          },
          "isHost": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      },
      "WeatherForecast": {
        "type": "object",
        "properties": {
          "date": {
            "type": "string",
            "format": "date"
          },
          "temperatureC": {
            "type": "integer",
            "format": "int32"
          },
          "temperatureF": {
            "type": "integer",
            "format": "int32",
            "readOnly": true
          },
          "summary": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      }
    }
  }
}